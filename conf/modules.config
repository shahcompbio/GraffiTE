/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/
process {
    withName: BCFTOOLS_NORM {
        ext.args   = { '-m- --check-ref s' }
        ext.prefix = { "${meta.id}.norm" }
        publishDir = [
            path: { "${params.out}/bcftools_norm" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: BCFTOOLS_SORT {
        publishDir = [
            path: { "${params.out}/TE_annotation" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: BCFTOOLS_QUERY {
        ext.args   = { "-f '%CHROM\\t%POS\\t%INFO/END\\t%INFO/SVLEN\\t%ID\\t%REF\\t%ALT\\t%FILTER\\t%INFO/SUPP\\t%INFO/SUPP_VEC\\t%INFO/SVTYPE\\t%INFO/STRANDS\\t%INFO/n_hits\\t%INFO/fragmts\\t%INFO/match_lengths\\t%INFO/repeat_ids\\t%INFO/matching_classes\\t%INFO/RM_hit_strands\\t%INFO/RM_hit_IDs\\t%INFO/total_match_length\\t%INFO/total_match_span\\t%INFO/mam_filter_1\\t%INFO/mam_filter_2\\t%INFO/TSD\\t[%GT]\\n' -u -H" }
        ext.suffix = 'tsv'
        publishDir = [
            path: { "${params.out}/TE_annotation" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }
    // set container for all other GRAFFITE processes
    withName: '!(.*BCFTOOLS.*)' {
        container = 'library://cgroza/collection/graffite:latest'
    }
    // more resources for pangenie
    withName: pangenie {
        cpus       = { 16 }
        memory     = { 100.GB * task.attempt }
        time       = { 16.h * task.attempt }
        publishDir = [
            path: { "${params.out}/4_Genotyping" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }
    // fix publishdirs for processes missing these
    withName: '.*tsd_.*|.*split_repeatmask.*' {
        publishDir = [
            path: { "${params.out}" },
            enabled: false,
        ]
    }
}
